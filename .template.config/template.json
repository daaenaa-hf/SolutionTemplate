{
  "$schema": "https://json.schemastore.org/template",
  "author": "Hesam Farid Mehr",
  "classifications": [
    "Solution",
    "Common"
  ],
  "identity": "SolutionTemplate",
  "name": "Solution Template (CPM, NBGV, Sonar, Husky)",
  "description": "Empty .slnx solution with central package management, Nerdbank.GitVersioning, SonarAnalyzer, Husky git hooks and strict build settings.",
  "shortName": "sln-base",
  "defaultName": "MySolution",
  "preferDefaultName": true,
  "preferNameDirectory": true,
  "placeholderFilename": "-.-",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "constraints": {
    "sdk": {
      "type": "sdk-version",
      "args": "10.0.402"
    }
  },
  "primaryOutputs": [
    { "path": "Solution.slnx" }
  ],
  "symbols": {
    "Git": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Initialize a git repository and create the initial commit."
    },
    "SolutionFileName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "fileRename": "Solution",
      "description": "Renames Solution.slnx to <name>.slnx."
    },
    "ReadmeTitle": {
      "type": "generated",
      "generator": "join",
      "replaces": "# Solution",
      "parameters": {
        "symbols": [
          {
            "type": "const",
            "value": "# "
          },
          {
            "type": "ref",
            "value": "name"
          }
        ],
        "separator": ""
      }
    }
  },
  "sources": [
    {
      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".git/**",
        ".vs/**",
        ".husky/_/**",
        "**/*.user",
        "**/*.binlog"
      ]
    }
  ],
  "postActions": [
    {
      "condition": "(Git)",
      "description": "Initialize git repository.",
      "manualInstructions": [
        {
          "text": "Run 'git init -b main'"
        }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "init -b main",
        "redirectStandardOutput": false
      }
    },
    {
      "condition": "(Git)",
      "description": "Stage all files.",
      "manualInstructions": [
        {
          "text": "Run 'git add -A'"
        }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "add -A",
        "redirectStandardOutput": false
      }
    },
    {
      "condition": "(Git)",
      "description": "Create initial commit.",
      "manualInstructions": [
        {
          "text": "Run 'git commit -m \"Initial commit\"'"
        }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "commit -m \"Initial commit\"",
        "redirectStandardOutput": false
      }
    }
  ]
}